<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Welcome</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background: #f4f4f4;
        padding: 20px;
        border-radius: 5px;
        text-align: center;
      }
      .footer {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #eee;
        font-size: 12px;
        color: #666;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Welcome <%= userName %>!</h1>
      </div>
      <p>
        Thank you for joining <%= process.env.APP_NAME || 'our platform' %>.
      </p>
      <p>
        Your account has been successfully created and you can now start using
        our services.
      </p>
      <p>
        For enhanced security, we recommend setting up two-factor authentication
        in your account settings.
      </p>
      <div class="footer">
        <p>This is an automated message, please do not reply to this email.</p>
      </div>
    </div>
  </body>
</html>
